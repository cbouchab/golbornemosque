// Hosts the website on Cloudflare Pages at golbornemosque.pages.dev, in the
// personal Cloudflare account of cbouchab@gmail.com. There is no server code:
// Cloudflare serves the files that scripts/build.sh collects into _site/.
// Pages config can't hold the account ID, so deploys set CLOUDFLARE_ACCOUNT_ID
// (see README), which makes them fail rather than land on any other account.
{
  "name": "golbornemosque",
  "pages_build_output_dir": "./_site",
  "compatibility_date": "2026-10-02"
}
